# Copy to .env and fill in your values. .env is git-ignored.

# Anthropic API key — used to write the answer (only `make ask` needs it)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Claude model that writes the answer
ANSWER_MODEL=claude-haiku-5-5

# Local embedding model (downloaded once on first `make ingest`, ~70 MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Folder of .md / .txt / .pdf files to index
DOCS_DIR=data/docs

# How many passages to retrieve per question
TOP_K=5
